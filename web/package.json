{
  "name": "openbpm-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hosted documentation for openBPM, published at fobiat.dev/openbpm.",
  "scripts": {
    "sync": "node scripts/sync-docs.mjs",
    "dev": "npm run sync && astro dev",
    "build": "npm run sync && astro build && node scripts/nest-base.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/starlight": "^0.41.4",
    "astro": "^7.1.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260801.1": true,
    "sharp@0.34.5": true
  }
}
